# 复制为 .env 后填写。--provider mock 离线运行时无需任何配置。

# 必填（真实模型）：Anthropic API key
ANTHROPIC_API_KEY=

# 可选：API 网关地址。直连 Anthropic 时留空；走兼容 Anthropic Messages API 的中转时填其地址
ANTHROPIC_BASE_URL=

# 可选：模型 ID，默认 claude-opus-5-5
KB_AGENT_MODEL=claude-opus-5-5

# 可选：推理强度 low | medium | high | xhigh | max，默认 medium
KB_AGENT_EFFORT=medium

# 可选：服务端拒答兜底（beta）。直连 Anthropic 用 default；中转网关不支持时设为 off
KB_AGENT_FALLBACKS=default
